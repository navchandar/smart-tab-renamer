{
  "manifest_version": 3,
  "name": "Smart Tab Renamer",
  "version": "0.1.0",
  "description": "Rename browser tabs with intuitive rules, container support, and persistent title enforcement",
  "author": "navchandar",
  "homepage_url": "https://github.com/navchandar/smart-tab-renamer",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "storage",
    "menus",
    "contextualIdentities",
    "cookies",
    "bookmarks"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": [
      "shared/storage.js",
      "shared/validators.js",
      "shared/templates.js",
      "background/containers.js",
      "background/rules-engine.js",
      "background/tabs-manager.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/title-controller.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Smart Tab Renamer",
    "default_popup": "dialogs/rename-dialog.html"
  },
  "options_ui": {
    "page": "options/settings.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-tab-renamer-mv3@navchandar.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
